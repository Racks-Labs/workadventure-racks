# Copiar a .env en el servidor B. NUNCA commitear el .env real.
LIVEKIT_DOMAIN=livekit.racks.university
TURN_DOMAIN=turn.racks.university
ACME_EMAIL=<email técnico>
PUBLIC_IP=<IP pública del servidor B>
# Generar con: openssl rand -hex 16  (key)  /  openssl rand -hex 32  (secret)
LIVEKIT_API_KEY=<...>
LIVEKIT_API_SECRET=<...>
# Generar con: openssl rand -hex 32. El MISMO valor va en el .env del servidor A.
TURN_STATIC_AUTH_SECRET=<...>
