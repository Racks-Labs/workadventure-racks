# Overrides para el campus de Racks University.
# Uso: cp contrib/docker/.env.prod.template .env  y sustituir/añadir estas claves.
# ENABLE_TELEMETRY, SECURITY_EMAIL y OPENID_TAGS_CLAIM solo llegan a los contenedores
# con racks/deploy/campus/docker-compose.override.yaml.
# Valores entre <> = rellenar. NUNCA commitear el .env real.
# Explicación de cada decisión: racks/PLAN-INCORPORACION.md

# --- Base ---------------------------------------------------------------
VERSION=<tag de release, p.ej. v1.34.x — nunca master>
DOMAIN=campus.racks.university
ACME_EMAIL=<email técnico>
SECRET_KEY=<openssl rand -hex 32>
TZ=Europe/Madrid
# Mapa por defecto en map-storage (subir antes campus.wam)
START_ROOM_URL=/~/campus.wam
ENABLE_TELEMETRY=false
SECURITY_EMAIL=<email técnico>

# --- Acceso --------------------------------------------------------------
DISABLE_ANONYMOUS=true
ENABLE_MAP_EDITOR=true
MAP_EDITOR_ALLOW_ALL_USERS=false
MAP_EDITOR_ALLOWED_USERS=<emails de editores separados por coma>

# --- SSO con Logto (app "WorkAdventure Campus", Traditional web) ----------
# Redirect URI a registrar en Logto: https://campus.racks.university/openid-callback
OPENID_CLIENT_ISSUER=https://auth.racks.academy/oidc
OPENID_CLIENT_ID=<App ID de Logto>
OPENID_CLIENT_SECRET=<App secret de Logto>
OPENID_SCOPE=openid email profile roles
OPENID_USERNAME_CLAIM=name
OPENID_WOKA_NAME_POLICY=allow_override_opid
# OJO: docker-compose.prod.yaml NO pasa esta variable a "play"; añadirla a mano.
# WA espera tags en minúsculas ("admin", "editor"): verificar antes de confiar en ella.
# OPENID_TAGS_CLAIM=roles

# --- Admin API (fase 2: puente en academy-routes) ------------------------
# Vacío = modo local (sin control por plan). WA envía el token SIN "Bearer ".
# Puente: rama feat/campus-workadventure-sso de academy-routes (src/lib/campus/AGENTS.md).
# SIN barra final. El token es el mismo que WORKADVENTURE_ADMIN_TOKEN en la academia.
# ADMIN_API_URL=https://learn.racks.university/api/internal/workadventure
ADMIN_API_URL=
ADMIN_API_TOKEN=
ADMIN_URL=

# --- Vídeo ---------------------------------------------------------------
# https (no wss): back usa la API HTTP y el navegador recibe la misma URL con ws en vez de http
LIVEKIT_HOST=https://livekit.racks.university
LIVEKIT_API_KEY=<el mismo que en el .env del servidor B>
LIVEKIT_API_SECRET=<el mismo que en el .env del servidor B>
TURN_SERVER=turn:turn.racks.university:3478?transport=udp,turn:turn.racks.university:3478?transport=tcp
TURN_STATIC_AUTH_SECRET=<el mismo que en el .env del servidor B>
STUN_SERVER=stun:turn.racks.university:3478
# No usamos Jitsi ni BBB: vaciar (el template trae un servidor BBB de PRUEBAS público)
JITSI_URL=
BBB_URL=
BBB_SECRET=

# --- Map storage ---------------------------------------------------------
MAP_STORAGE_AUTHENTICATION_USER=<usuario>
MAP_STORAGE_AUTHENTICATION_PASSWORD=<contraseña fuerte>
MAP_STORAGE_ENABLE_BEARER_AUTHENTICATION=true
MAP_STORAGE_AUTHENTICATION_TOKEN=<openssl rand -hex 32>

# --- Integraciones (fase 3) ----------------------------------------------
# Activa la Room API gRPC (puerto 50051) para que Racks abra puertas/envíe eventos.
# ROOM_API_SECRET_KEY=<openssl rand -hex 32>

# --- Chat Matrix: no se monta en fase 1 (Racks tiene su chat) ------------
MATRIX_API_URI=
MATRIX_PUBLIC_URI=
MATRIX_DOMAIN=

# --- Experiencia del alumno (ver racks/CUSTOMIZACION.md) -----------------
# Las marcadas [sin Admin API] solo cuentan mientras ADMIN_API_URL esté vacío:
# con el puente activo las decide la academia en /api/map.
FALLBACK_LOCALE=es-ES
# Nombres de 10 caracteres se quedan cortos para "Nombre Apellido".
MAX_USERNAME_LENGTH=20
# Burbuja: hasta 4 en P2P; por encima pasa a LiveKit. Más de 8 en una burbuja informal
# es una reunión: para eso están las áreas de reunión del mapa.
MAX_PER_GROUP=8
MAX_USERS_FOR_WEBRTC=4
MAX_DISPLAYED_VIDEOS=12
# Menos resolución de vídeo = menos tráfico en el servidor de media (1 = máxima).
LIVEKIT_PIXEL_DENSITY=0.66
WOKA_SPEED=9
ENABLE_TUTORIAL=true
# Herramientas embebibles en el mapa (gratuitas, sin claves).
EXCALIDRAW_ENABLED=true
TLDRAW_ENABLED=true
YOUTUBE_ENABLED=true
EMBEDDED_DOMAINS_WHITELIST=learn.racks.university,racks.university,forum.racks.university,prompts.racks.university
# Perfil: el botón "Perfil" de WorkAdventure lleva a la edición de perfil de Racks.
OPENID_PROFILE_SCREEN_PROVIDER=https://learn.racks.university/profile/edit
# "Informar de un problema" → soporte de Racks.
ENABLE_REPORT_ISSUES_MENU=true
REPORT_ISSUES_URL=https://forum.racks.university
# [sin Admin API] — solo llegan con racks/deploy/campus/docker-compose.override.yaml
CONTACT_URL=https://forum.racks.university
ENABLE_SAY=true
ENABLE_ISSUE_REPORT=false
SKIP_CAMERA_PAGE=false
DEFAULT_CAMERA_PRIVACY_SETTINGS=false
DEFAULT_MICROPHONE_PRIVACY_SETTINGS=false
